<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext traffic. The WebView only loads the trusted HTTPS origin. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>